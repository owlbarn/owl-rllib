# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Reinforcement learning on top of the Owl numerical library"
description: """
Tabular methods, dynamic programming, DQN, REINFORCE, A2C and PPO on Owl's
neural networks, classic control environments checked against Gymnasium,
RL algorithms for language-model fine-tuning (REINFORCE, RLOO, PPO, GRPO and
its variants) on a toy model, and an optional bridge to Gymnasium and VizDoom
running in a Python child process."""
maintainer: ["Jianxin Zhao"]
authors: ["Jianxin Zhao"]
license: "MIT"
tags: ["reinforcement-learning" "machine-learning" "owl"]
homepage: "https://github.com/owlbarn/owl-rllib"
bug-reports: "https://github.com/owlbarn/owl-rllib/issues"
depends: [
  "dune" {>= "3.16"}
  "ocaml" {>= "5.1"}
  "owl" {>= "1.3"}
  "alcotest" {with-test & >= "1.0.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/owlbarn/owl-rllib.git"
x-maintenance-intent: [ "(latest)" ]
